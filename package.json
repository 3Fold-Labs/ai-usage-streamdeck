{
  "name": "ai-usage-streamdeck",
  "version": "0.0.75",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate": "streamdeck validate com.3foldlabs.ai-usage.sdPlugin",
    "pack": "npm run build && streamdeck pack com.3foldlabs.ai-usage.sdPlugin --output dist --force --no-update-check && node scripts/brand-package.mjs",
    "security:release": "node scripts/security-release.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:verify-candidate": "node scripts/verify-candidate.mjs",
    "candidate:freeze": "node scripts/freeze-candidate.mjs",
    "candidate:version": "node scripts/version-candidate.mjs",
    "release:sign-tag": "node scripts/sign-release-tag.mjs",
    "build:check": "node scripts/build.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.13.3",
    "esbuild": "0.25.12",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "simple-icons": "12.4.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "description": "Personal AI subscription usage at a glance for Elgato Stream Deck",
  "author": "3Fold Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/3Fold-Labs/ai-usage-streamdeck.git"
  }
}
